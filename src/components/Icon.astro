  stroke={isBrand ? 'none' : 'currentColor'}
  stroke-width={isBrand ? undefined : 1.8}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={inner}
/>
