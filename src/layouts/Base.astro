---
// Layout compartido: <head>, header/nav, footer y botón flotante de WhatsApp.
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import {
  NAV,
  WA_COTIZAR,
  EMAIL_CONTACTO,
  TELEFONO_DISPLAY,
  CIUDAD,
  RAZON_SOCIAL,
  NIT,
  REDES,
  HORARIO_SEMANA,
  HORARIO_SABADO,
} from '../lib/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

// SEO: URLs canónicas absolutas sobre el dominio de producción (astro.config `site`).
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/img/og-default.jpg', Astro.site);

// Datos estructurados (schema.org) — dirección solo a nivel de ciudad, por privacidad.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'TMI Colombia SAS',
  legalName: 'Tecnologías Médicas Integrales Colombia SAS',
  url: Astro.site?.href,
  logo: new URL('/img/logo-original.jpg', Astro.site).href,
  image: ogImage.href,
  description:
    'Comercialización de medicamentos, dispositivos médicos, equipos biomédicos y material médico-quirúrgico para clientes del sector salud de la Costa Caribe colombiana.',
  telephone: '+573013804160',
  email: 'gerencia@tmicol.co',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Montería',
    addressRegion: 'Córdoba',
    addressCountry: 'CO',
  },
  areaServed: 'Costa Caribe, Colombia',
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '12:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '14:00', closes: '17:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
  ],
  sameAs: ['https://www.linkedin.com/in/tmicolsas2026/', 'https://www.instagram.com/tmi.col'],
});

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B2545" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,800&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="TMI Colombia SAS" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd} />
    <meta property="og:locale" content="es_CO" />
  </head>
  <body>
    <header class="site-header">
      <div class="topbar">
        <div class="topbar-inner">
          <span>{CIUDAD} · {HORARIO_SEMANA} · {HORARIO_SABADO}</span>
          <span>{TELEFONO_DISPLAY} · {EMAIL_CONTACTO}</span>
        </div>
      </div>
      <div class="nav-wrap">
        <a href="/" class="logo" aria-label="TMI — Inicio">
          <Logo variant="dark" height={34} />
          <small class="logo-tagline">Tecnologías Médicas Integrales</small>
        </a>
        <nav class="site-nav" aria-label="Navegación principal">
          <ul id="navMenu">
            {NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="nav-cta">
          <a class="btn btn-wsp" target="_blank" rel="noopener" href={WA_COTIZAR}>
            <Icon name="whatsapp" size={18} />
            <span class="txt">Cotizar</span>
          </a>
          <button class="burger" id="burger" aria-expanded="false" aria-controls="navMenu" aria-label="Abrir menú">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <div class="footer-logo"><Logo variant="dark" height={40} /></div>
            <p>
              {RAZON_SOCIAL}. Comercialización de medicamentos, dispositivos médicos, equipos
              biomédicos y material médico-quirúrgico para los clientes del sector salud de la
              Costa Caribe.
            </p>
            <div class="footer-social">
              {REDES.map((red) => (
                <a href={red.url} target="_blank" rel="noopener" aria-label={`TMI en ${red.nombre}`}>
                  <Icon name={red.icon} size={18} />
                </a>
              ))}
            </div>
          </div>
          <div class="footer-col">
            <h4>Navegación</h4>
            <a href="/nosotros">Nosotros</a>
            <a href="/lineas">Líneas de venta</a>
            <a href="/consulta-especializada">Consulta especializada</a>
            <a href="/como-trabajamos">Cómo trabajamos</a>
            <a href="/transparencia">Transparencia</a>
          </div>
          <div class="footer-col">
            <h4>Únete</h4>
            <a href="/trabaja-con-nosotros">Trabaja con nosotros</a>
            <a href="/proveedores">Sé nuestro proveedor</a>
            <a href="/vinculacion/clientes">Vinculación de clientes</a>
            <a href="/vinculacion/proveedores">Vinculación de proveedores</a>
            <a href="/cotizar">Solicitar cotización</a>
          </div>
          <div class="footer-col">
            <h4>Contacto</h4>
            <div class="footer-contact-item"><Icon name="map-pin" size={16} /> {CIUDAD}</div>
            <div class="footer-contact-item"><Icon name="phone" size={16} /> {TELEFONO_DISPLAY}</div>
            <div class="footer-contact-item"><Icon name="mail" size={16} /> {EMAIL_CONTACTO}</div>
            <div class="footer-contact-item"><Icon name="clock" size={16} /> {HORARIO_SEMANA}<br />{HORARIO_SABADO}</div>
            <a href="/contacto">Ver página de contacto</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© <span id="year"></span> {RAZON_SOCIAL} — {NIT} — Todos los derechos reservados.</span>
          <span class="footer-legal-group">
            <a class="footer-legal" href="/politica-de-datos">Política de datos personales</a>
            ·
            <a class="footer-legal" href="/terminos-y-condiciones">Términos y condiciones</a>
          </span>
          <span>Integridad · Calidad · Innovación · Compromiso</span>
        </div>
      </div>
    </footer>

    <a
      class="wsp-float"
      target="_blank"
      rel="noopener"
      href={WA_COTIZAR}
      aria-label="Escríbenos por WhatsApp"
    >
      <Icon name="whatsapp" size={28} />
    </a>

    <script>
      // Menú móvil
      const burger = document.getElementById('burger');
      const navMenu = document.getElementById('navMenu');
      burger?.addEventListener('click', () => {
        const open = navMenu?.classList.toggle('open');
        burger.setAttribute('aria-expanded', String(Boolean(open)));
        burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      });
      navMenu?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          navMenu.classList.remove('open');
          burger?.setAttribute('aria-expanded', 'false');
        })
      );

      // Año dinámico
      const year = document.getElementById('year');
      if (year) year.textContent = String(new Date().getFullYear());

      // Reveal on scroll
      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('show');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('show'));
      }

      // Sombra en header al hacer scroll
      const header = document.querySelector<HTMLElement>('.site-header');
      window.addEventListener('scroll', () => {
        if (header) header.style.boxShadow = window.scrollY > 30 ? '0 6px 24px rgba(0,0,0,.25)' : 'none';
      });
    </script>
  </body>
</html>
