---
import Base from '../../layouts/Base.astro';
import LineaDetail from '../../components/LineaDetail.astro';

// TODO(PENDIENTES.md §3): sustituir por la lista real de subcategorías que TMI
// puede vender hoy, cuando la operación la confirme.
const items = [
  'Medicamentos con registro sanitario vigente',
  'Manejo de cadena de frío y condiciones de conservación controladas',
  'Trazabilidad completa por lote en cada entrega',
  'Acompañamiento en farmacovigilancia con nuestro Químico Farmacéutico',
];
---
<Base
  title="Medicamentos | Líneas de venta | TMI Colombia SAS"
  description="Distribución de medicamentos con registro sanitario vigente, cadena de frío y trazabilidad por lote para clientes del sector salud de la Costa Caribe."
>
  <LineaDetail
    slug="medicamentos"
    fotoLabel="Medicamentos en superficie clínica"
    intro="Suministramos medicamentos para el sector salud con verificación de cumplimiento normativo referencia por referencia, condiciones de conservación controladas y soporte farmacéutico especializado."
    items={items}
  />
</Base>
