---
import Base from '../../layouts/Base.astro';
import LineaDetail from '../../components/LineaDetail.astro';

// TODO(PENDIENTES.md §3): sustituir por la lista real de subcategorías que TMI
// puede vender hoy, cuando la operación la confirme.
const items = [
  'Material médico-quirúrgico de uso hospitalario',
  'Dispositivos médicos con registro sanitario vigente',
  'Disponibilidad y entrega oportuna para tu operación',
  'Acompañamiento en tecnovigilancia',
];
---
<Base
  title="Insumos médico-quirúrgicos | Líneas de venta | TMI Colombia SAS"
  description="Material médico-quirúrgico y dispositivos médicos de uso hospitalario con registro sanitario, disponibilidad y entrega oportuna en la Costa Caribe."
>
  <LineaDetail
    slug="insumos-medico-quirurgicos"
    fotoLabel="Insumos quirúrgicos estériles"
    intro="Proveemos material médico-quirúrgico y dispositivos médicos para uso hospitalario, con verificación de registro sanitario y entrega oportuna donde tu operación lo necesita."
    items={items}
  />
</Base>
